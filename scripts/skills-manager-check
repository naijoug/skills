#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APPS_DIR="$ROOT_DIR/apps"
cd "$APPS_DIR"

pnpm test
pnpm typecheck

if [[ -d skills-manager-web/dist ]]; then
  if rg --fixed-strings "OPENAI_API_KEY" skills-manager-web/dist; then
    echo "Web bundle must not contain OPENAI_API_KEY references." >&2
    exit 1
  fi
  if rg --fixed-strings "api.openai.com/v1/responses" skills-manager-web/dist; then
    echo "Web bundle must not call OpenAI directly; use the API or desktop provider boundary." >&2
    exit 1
  fi
fi

(
  cd skills-manager-desktop/src-tauri
  cargo test
  cargo check
)

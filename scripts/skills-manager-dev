#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APPS_DIR="$ROOT_DIR/apps"
cd "$APPS_DIR"

API_PORT="${SKILLS_MANAGER_API_PORT:-8787}"
WEB_PORT="${SKILLS_MANAGER_WEB_PORT:-5173}"
WEB_HOST="${SKILLS_MANAGER_WEB_HOST:-127.0.0.1}"
API_LOG="${SKILLS_MANAGER_API_LOG:-/tmp/skills-manager-api.log}"
WEB_LOG="${SKILLS_MANAGER_WEB_LOG:-/tmp/skills-manager-web.log}"

cleanup() {
  if [[ -n "${API_PID:-}" ]]; then
    kill "$API_PID" 2>/dev/null || true
  fi
  if [[ -n "${WEB_PID:-}" ]]; then
    kill "$WEB_PID" 2>/dev/null || true
  fi
}

trap cleanup EXIT INT TERM

SKILLS_MANAGER_API_PORT="$API_PORT" pnpm --filter skills-manager-api start >"$API_LOG" 2>&1 &
API_PID="$!"

for _ in {1..60}; do
  if curl -L -sS --fail "http://127.0.0.1:${API_PORT}/health" >/dev/null 2>&1; then
    break
  fi
  sleep 0.25
done

if ! curl -L -sS --fail "http://127.0.0.1:${API_PORT}/health" >/dev/null 2>&1; then
  echo "Skills Manager API failed to start. Log: $API_LOG" >&2
  sed -n '1,120p' "$API_LOG" >&2 || true
  exit 1
fi

VITE_SKILLS_MANAGER_API_URL="http://127.0.0.1:${API_PORT}" pnpm --filter skills-manager-web dev --host "$WEB_HOST" --port "$WEB_PORT" --strictPort >"$WEB_LOG" 2>&1 &
WEB_PID="$!"

for _ in {1..60}; do
  if curl -L -sS --fail "http://${WEB_HOST}:${WEB_PORT}" >/dev/null 2>&1; then
    break
  fi
  sleep 0.25
done

if ! curl -L -sS --fail "http://${WEB_HOST}:${WEB_PORT}" >/dev/null 2>&1; then
  echo "Skills Manager Web failed to start. Log: $WEB_LOG" >&2
  sed -n '1,120p' "$WEB_LOG" >&2 || true
  exit 1
fi

echo "Skills Manager API: http://127.0.0.1:${API_PORT}"
echo "Skills Manager Web: http://${WEB_HOST}:${WEB_PORT}"
echo "API log: $API_LOG"
echo "Web log: $WEB_LOG"
wait "$API_PID" "$WEB_PID"

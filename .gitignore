# macOS
.DS_Store
.AppleDouble
.LSOverride

# Temporary files
*.tmp
*.log
node_modules/
dist/
target/
*.tsbuildinfo
apps/skills-manager-desktop/src-tauri/gen/

# Python cache (trigger eval scripts)
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/

# Local tool settings
.claude/settings.local.json
.alma-snapshots

# Skill development workspaces
skills/manual/research/web-search/workspace/
skills/manual/tool/search/workspace/
.omx/

.ref/

# Local Skills Manager imports/cache
.skills-manager-data/

# Local QA workspace
.qa/

# Local macOS signing secrets (public .cer files remain trackable)
apps/skills-manager-desktop/src-tauri/certificates/*.p12
apps/skills-manager-desktop/src-tauri/certificates/*.pfx
apps/skills-manager-desktop/src-tauri/certificates/*.p8
apps/skills-manager-desktop/src-tauri/certificates/*.key
apps/skills-manager-desktop/src-tauri/certificates/*.mobileprovision
apps/skills-manager-desktop/src-tauri/certificates/*.provisionprofile
apps/skills-manager-desktop/src-tauri/certificates/.env*

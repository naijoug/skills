#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
SKILLS_ROOT="$ROOT_DIR/skills"
LINKER="$ROOT_DIR/apps/skills-manager-tui/skills-linker"

usage() {
  cat <<'EOF'
Usage:
  ng                              Pick a manual skill interactively
  ng list                         List manual skills
  ng plan                         Show the category plan
  ng <skill-id> [extra...]        Show how to trigger a specific skill
  ng <group> <verb> [extra...]    Resolve to skill "<group>-<verb>" and include extras in the suggested prompt
                                  e.g. ng plan create "payment module rewrite"
                                       ng plan review docs/plans/foo.md

Notes:
  - `global` skills should be installed globally and auto-trigger after installation
  - `auto` skills auto-trigger after installation
  - `cron` skills are meant for recurring automation jobs
  - `manual` skills are the ones exposed by `ng`, grouped by directory
EOF
}

load_items_json() {
  "$LINKER" list --skills-root "$SKILLS_ROOT" --json "$@"
}

print_manual_list() {
  load_items_json --category manual | python3 -c '
import json, sys
data = json.load(sys.stdin)
items = data.get("items", [])
order = ("plan", "review", "tool", "growth", "meta")
groups = {name: [] for name in order}
for item in items:
    groups.setdefault(item.get("manual_group") or "other", []).append(item)

for group in [*order, *sorted(k for k in groups if k not in order)]:
    bucket = groups.get(group) or []
    if not bucket:
        continue
    print(f"# {group}")
    for item in bucket:
        skill_id = item["id"]
        path = item.get("path") or skill_id
        title = item.get("title") or skill_id
        summary = item.get("summary") or ""
        print(f"{group}\t{skill_id}\t{title}\t{summary}\t{path}")
'
}

print_category_plan() {
  load_items_json | python3 -c '
import json, sys
data = json.load(sys.stdin)
items = data.get("items", [])
groups = {"global": [], "cron": [], "auto": [], "manual": []}
for item in items:
    groups.setdefault(item.get("category", "manual"), []).append(item)

notes = {
    "global": "Install globally; auto-injected into agent instructions.",
    "cron": "Do not trigger manually; wire these into recurring automation jobs.",
    "auto": "Install once; they act as passive auto-trigger helpers.",
    "manual": "Use ng to list and choose these skills on demand.",
}

for category in ("global", "cron", "auto", "manual"):
    bucket = groups.get(category, [])
    print(f"[{category}] {notes[category]}")
    if not bucket:
        print("- none")
        print("")
        continue
    if category != "manual":
        for item in bucket:
            skill_id = item["id"]
            title = item.get("title") or skill_id
            print(f"- {skill_id}: {title}")
        print("")
        continue

    order = ("plan", "review", "tool", "growth", "meta")
    subgroups = {name: [] for name in order}
    for item in bucket:
        subgroups.setdefault(item.get("manual_group") or "other", []).append(item)
    for group in [*order, *sorted(k for k in subgroups if k not in order)]:
        members = subgroups.get(group) or []
        if not members:
            continue
        print(f"- {group}:")
        for item in members:
            skill_id = item["id"]
            title = item.get("title") or skill_id
            print(f"  - {skill_id}: {title}")
    print("")
'
}

skill_id_exists() {
  local skill_id="$1"
  load_items_json | python3 -c '
import json, sys
skill_id = sys.argv[1]
data = json.load(sys.stdin)
for item in data.get("items", []):
    path_name = (item.get("path") or "").rstrip("/").split("/")[-1]
    group = item.get("manual_group") or ""
    aliases = {item["id"], path_name}
    if group and path_name:
        aliases.add(f"{group}-{path_name}")
        aliases.add(f"ng-{group}-{path_name}")
    if skill_id in aliases:
        raise SystemExit(0)
raise SystemExit(1)
' "$skill_id"
}

print_skill_plan() {
  local skill_id="$1"
  shift
  local extra="$*"
  load_items_json | python3 -c '
import json, sys

skill_id = sys.argv[1]
extra = sys.argv[2] if len(sys.argv) > 2 else ""
data = json.load(sys.stdin)
item = None
for candidate in data.get("items", []):
    path_name = (candidate.get("path") or "").rstrip("/").split("/")[-1]
    group = candidate.get("manual_group") or ""
    aliases = {candidate["id"], path_name}
    if group and path_name:
        aliases.add(f"{group}-{path_name}")
        aliases.add(f"ng-{group}-{path_name}")
    if skill_id in aliases:
        item = candidate
        skill_id = candidate["id"]
        break
if item is None:
    print(f"error: unknown skill id: {skill_id}", file=sys.stderr)
    raise SystemExit(1)

category = item.get("category", "manual")
manual_group = item.get("manual_group") or ""
title = item.get("title") or skill_id
summary = item.get("summary") or ""

print(f"Skill: {skill_id}")
print(f"Title: {title}")
print(f"Category: {category}")
if manual_group:
    print(f"Directory Group: {manual_group}")
if summary:
    print(f"Summary: {summary}")
print("")

if category == "manual":
    print("Trigger plan:")
    print(f"- Slash command (after install): /{skill_id} <args>")
    print(f"- Or mention `{skill_id}` explicitly in any agent.")
    if extra:
        print("")
        print("Suggested prompt:")
        print(f"  Use the `{skill_id}` skill for this task: {extra}")
    else:
        print(f"- Suggested prompt: Use the `{skill_id}` skill for this task.")
elif category == "global":
    print("Trigger plan:")
    print("- This is a global auto-trigger skill. Install it globally; do not invoke it manually.")
elif category == "auto":
    print("Trigger plan:")
    print("- This is an installed auto-trigger helper. Install it once; it should activate passively.")
elif category == "cron":
    print("Trigger plan:")
    print("- This skill is intended for recurring automation, not manual invocation.")
' "$skill_id" "$extra"
}

pick_manual_skill() {
  if ! command -v fzf >/dev/null 2>&1; then
    print_manual_list
    return 0
  fi

  local choice
  choice="$(
    print_manual_list \
      | awk -F '\t' 'NF >= 4 {print}' \
      | fzf --with-nth=2,3 --delimiter=$'\t' \
          --prompt="ng>manual> " \
          --height=70% --layout=reverse --border --info=inline \
          --header="group | skill | title" \
          --preview 'cat "'"$SKILLS_ROOT"'"/{5}/SKILL.md 2>/dev/null || echo "No SKILL.md found"' \
          --preview-window 'right,60%,wrap'
  )" || return 1

  local skill_id
  skill_id="$(printf '%s' "$choice" | awk -F '\t' 'NF >= 2 {print $2}')"
  [[ -n "$skill_id" ]] || return 1
  print_skill_plan "$skill_id"
}

cmd="${1:-}"
case "$cmd" in
  "")
    pick_manual_skill
    ;;
  -h|--help|help)
    usage
    ;;
  list)
    print_manual_list
    ;;
  plan)
    if [[ $# -ge 2 ]]; then
      # `ng plan <verb> [extras...]` → resolve to ng-plan-<verb> skill
      verb="$2"
      shift 2
      combined="ng-plan-${verb}"
      if skill_id_exists "$combined"; then
        print_skill_plan "$combined" "$@"
      else
        echo "error: no skill named '${combined}' under plan/." >&2
        echo "try: ng list   (to see available plan skills)" >&2
        exit 1
      fi
    else
      print_category_plan
    fi
    ;;
  *)
    # Try group-verb dispatch: ng <group> <verb> [extras...]
    if [[ $# -ge 2 ]]; then
      verb="$2"
      combined="ng-${cmd}-${verb}"
      if skill_id_exists "$combined"; then
        shift 2
        print_skill_plan "$combined" "$@"
        exit 0
      fi
    fi
    # Fallback: treat arg1 as skill id, pass remaining args as extras
    shift
    print_skill_plan "$cmd" "$@"
    ;;
esac

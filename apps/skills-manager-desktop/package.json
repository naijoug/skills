    "@tauri-apps/api": "^2.9.0",
    "@vitejs/plugin-react": "^5.1.1",
    "vite": "^7.2.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3"
  }
}

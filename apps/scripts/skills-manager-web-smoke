#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
APPS_DIR="$ROOT_DIR/apps"
cd "$APPS_DIR"

API_PORT="${SKILLS_MANAGER_WEB_SMOKE_API_PORT:-8788}"
WEB_PORT="${SKILLS_MANAGER_WEB_SMOKE_WEB_PORT:-5176}"
DATA_DIR="$(mktemp -d "${TMPDIR:-/tmp}/skills-manager-web-smoke.XXXXXX")"
API_LOG="${SKILLS_MANAGER_WEB_SMOKE_API_LOG:-${DATA_DIR}/api.log}"
WEB_LOG="${SKILLS_MANAGER_WEB_SMOKE_WEB_LOG:-${DATA_DIR}/web.log}"

cleanup() {
  if [[ -n "${API_PID:-}" ]]; then
    kill "$API_PID" 2>/dev/null || true
  fi
  if [[ -n "${WEB_PID:-}" ]]; then
    kill "$WEB_PID" 2>/dev/null || true
  fi
  if [[ "${SKILLS_MANAGER_KEEP_WEB_SMOKE_DATA:-0}" != "1" ]]; then
    rm -rf "$DATA_DIR"
  else
    echo "Keeping Web smoke data directory: $DATA_DIR"
  fi
}

trap cleanup EXIT INT TERM

SKILLS_MANAGER_DATA_DIR="$DATA_DIR" SKILLS_MANAGER_API_PORT="$API_PORT" pnpm --filter skills-manager-api start >"$API_LOG" 2>&1 &
API_PID="$!"

for _ in {1..80}; do
  if curl -L -sS --fail "http://127.0.0.1:${API_PORT}/health" >/dev/null 2>&1; then
    break
  fi
  sleep 0.25
done

if ! curl -L -sS --fail "http://127.0.0.1:${API_PORT}/health" >/dev/null 2>&1; then
  echo "Skills Manager API failed to start. Log: $API_LOG" >&2
  sed -n '1,160p' "$API_LOG" >&2 || true
  exit 1
fi

VITE_SKILLS_MANAGER_API_URL="http://127.0.0.1:${API_PORT}" pnpm --filter skills-manager-web dev --host 127.0.0.1 --port "$WEB_PORT" >"$WEB_LOG" 2>&1 &
WEB_PID="$!"

for _ in {1..80}; do
  if curl -L -sS --fail "http://127.0.0.1:${WEB_PORT}" >/dev/null 2>&1; then
    break
  fi
  sleep 0.25
done

if ! curl -L -sS --fail "http://127.0.0.1:${WEB_PORT}" >/dev/null 2>&1; then
  echo "Skills Manager Web failed to start. Log: $WEB_LOG" >&2
  sed -n '1,160p' "$WEB_LOG" >&2 || true
  exit 1
fi

SKILLS_MANAGER_API_URL="http://127.0.0.1:${API_PORT}" \
  SKILLS_MANAGER_WEB_URL="http://127.0.0.1:${WEB_PORT}" \
  "$ROOT_DIR/apps/scripts/skills-manager-smoke"
